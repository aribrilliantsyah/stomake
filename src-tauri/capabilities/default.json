{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The app window loads the bundled local server; only it may use the native dialogs/opener.",
  "windows": ["main"],
  "remote": { "urls": ["http://127.0.0.1:*/*", "http://localhost:*/*"] },
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "http://127.0.0.1:*/*" }, { "url": "http://localhost:*/*" }]
    },
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "**" }]
    }
  ]
}
