{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main localhost app window may use native dialogs/opener and read clipboard images/text.",
  "windows": ["main"],
  "remote": { "urls": ["http://127.0.0.1:*/*", "http://localhost:*/*"] },
  "permissions": [
    "core:default",
    "allow-read-local-images",
    "dialog:allow-open",
    "dialog:allow-save",
    "clipboard-manager:allow-read-image",
    "clipboard-manager:allow-read-text",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "http://127.0.0.1:*/*" }, { "url": "http://localhost:*/*" }]
    },
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "**" }]
    }
  ]
}
