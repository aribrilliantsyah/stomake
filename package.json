{
  "name": "storyboard-maker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local storyboard maker: 9:16 scenes, multi-page, PDF export",
  "scripts": {
    "dev": "concurrently -k -n server,web \"tsx watch src/server/main.ts\" \"vite\"",
    "build": "vite build",
    "start": "pnpm build && NODE_ENV=production tsx src/server/main.ts",
    "test": "vitest run",
    "e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "packageManager": "pnpm@10.28.1",
  "dependencies": {
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/coming-soon": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@hono/node-server": "^2.1.4",
    "hono": "^4.13.13",
    "image-size": "^2.0.4",
    "konva": "^10.7.1",
    "mammoth": "^1.13.0",
    "playwright": "^1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-konva": "^19.3.0",
    "zod": "^4.6.6",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "jsdom": "^30.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
