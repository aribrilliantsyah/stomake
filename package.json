{
  "name": "stomake",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "description": "Stomake: local 9:16 storyboard maker, multi-page, PDF export",
  "scripts": {
    "dev": "concurrently -k -n server,web \"tsx watch src/server/main.ts\" \"vite\"",
    "build": "vite build",
    "start": "pnpm build && tsx src/server/main.ts --serve-dist",
    "test": "vitest run",
    "e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "desktop:stage": "node scripts/stage-desktop.mjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "release": "node scripts/release.mjs"
  },
  "packageManager": "pnpm@10.28.1",
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/coming-soon": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/lilita-one": "^5.3.0",
    "@fontsource/luckiest-guy": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/patrick-hand": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/roboto-slab": "^5.3.0",
    "@hono/node-server": "^2.1.4",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "fflate": "^0.8.3",
    "hono": "^4.13.13",
    "image-size": "^2.0.4",
    "konva": "^10.7.1",
    "lucide-react": "^1.56.0",
    "mammoth": "^1.13.0",
    "playwright": "^1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-konva": "^19.3.0",
    "zod": "^4.6.6",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
